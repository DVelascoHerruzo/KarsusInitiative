{
  "manifest_version": 3,
  "name": "Karsus Initiative",
  "short_name": "Karsus",
  "version": "1.0.0",
  "description": "Start a D&D encounter in Karsus from any tab: from scratch or from one of your presets.",
  "homepage_url": "https://karsusinitiative.com/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "New Karsus encounter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "host_permissions": ["https://karsusinitiative.com/*"]
}
